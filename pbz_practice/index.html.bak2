		setTimeout(function() {
    		$( document ).ready(function() {
                if($(window).width() > 768){
            		$('.mobile-video-ourworld').remove();
            	}else{
            		$('.desktop-video-ourworld').remove();
            	}
            });
		
				document.cookie = "highcontrast=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
		        document.cookie = "fontsizesite=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
				$('html').removeClass("incrText1");
		        $('html').removeClass("incrText2");
		        $('html').removeClass("highContrast");
			$(document).ready(function(){
				document.cookie = "highcontrast=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
		        document.cookie = "fontsizesite=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
				$('html').removeClass("incrText1");
		        $('html').removeClass("incrText2");
		        $('html').removeClass("highContrast");
				function getCookie(cname) {
				  var name = cname + "=";
				  var ca = document.cookie.split(';');
				  for(var i = 0; i < ca.length; i++) {
					var c = ca[i];
					while (c.charAt(0) == ' ') {
					  c = c.substring(1);
					}
					if (c.indexOf(name) == 0) {
					  return c.substring(name.length, c.length);
					}
				  }
				  return "";
		        }
		        console.log("check cookie");
		        var highcontr = getCookie("highcontrast");
		        var font1 = getCookie("fontsizesite");
		        if(highcontr == "" || highcontr == null || highcontr == undefined){
					$('html').removeClass("highContrast");
		            document.cookie = "highcontrast=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
		        } else {
		            $('html').addClass("highContrast");
		        }
		        if(font1 == "" || font1 == null){
		            $('html').removeClass("incrText1");
		            $('html').removeClass("incrText2");
		             document.cookie = "fontsizesite=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
		        } else {
		            $('html').addClass("incrText2");
		        }
	$(document).find("img").each(function(index, element){
		try{
			var el = $(element)[0];
			var src = el.getAttribute('src') || el.src || '';
			// If URL was rewritten to a root-relative Cloudinary path, convert to CDN absolute URL
			if(src.indexOf('/res.cloudinary.com/') === 0){
				el.src = 'https://' + src.replace(/^\/+/, '');
				src = el.src;
			}
			// Only append transform when it's not already present
			if(src.indexOf('res.cloudinary') > -1 && src.indexOf('/upload/w_') === -1 && src.indexOf('/upload/w_auto,c_scale/') === -1){
				el.src = src.replace('/upload/', '/upload/w_auto,c_scale/');
			}

			var dsrc = el.getAttribute('data-src');
			if(dsrc){
				if(dsrc.indexOf('/res.cloudinary.com/') === 0){
					dsrc = 'https://' + dsrc.replace(/^\/+/, '');
				}
				if(dsrc.indexOf('res.cloudinary') > -1 && dsrc.indexOf('/upload/w_') === -1 && dsrc.indexOf('/upload/w_auto,c_scale/') === -1){
					dsrc = dsrc.replace('/upload/', '/upload/w_auto,c_scale/');
				}
				el.setAttribute('data-src', dsrc);
			}
		} catch(e){}
	});
        
		$(document).find("source").each(function(index, element){
			try{
				var el = $(element)[0];
				var ss = el.getAttribute('srcset') || el.srcset || '';
				if(ss.indexOf('/res.cloudinary.com/') === 0){
					ss = 'https:' + ss;
				}
				if(ss.indexOf('res.cloudinary') > -1 && ss.indexOf('/upload/w_') === -1){
					ss = ss.replace('/upload/', '/upload/w_'+getWidthImage()+',c_scale/');
				}
				if(ss) el.srcset = ss;

				var dss = el.getAttribute('data-srcset');
				if(dss){
					if(dss.indexOf('/res.cloudinary.com/') === 0) dss = 'https:' + dss;
					if(dss.indexOf('res.cloudinary') > -1 && dss.indexOf('/upload/w_') === -1){
						dss = dss.replace('/upload/', '/upload/w_'+getWidthImage()+',c_scale/');
					}
					el.setAttribute('data-srcset', dss);
				}
			} catch(e){}
		});

// Ensure loan calculator shows default 'Stambeni' tab on load in the exported snapshot
(function(){
	function tryActivate(){
		try{
			if(window.intesa && window.intesa.loan_calculator_pbz){
				var c = window.intesa.loan_calculator_pbz;
				if(typeof c.setActiveTabByVal === 'function'){
					c.setActiveTabByVal(true, false, undefined);
					if(typeof c.changeCallback === 'function') c.changeCallback();
					return true;
				}
			}
			// fallback: open first com16 tab and trigger its toggle
			var firstTab = document.querySelector('.com16__tabs .com16__tabItem');
			if(firstTab && !firstTab.classList.contains('open')){
				firstTab.classList.add('open');
				var toggle = firstTab.querySelector('.js-com16__toggle');
				if(toggle) toggle.click();
				else{
					var btn = firstTab.querySelector('a, button');
					if(btn) btn.click();
				}
				return true;
			}
		}catch(e){}
		return false;
	}
	var tries = 0;
	var id = setInterval(function(){
		tries++;
		if(tryActivate() || tries>10) clearInterval(id);
	}, 300);
})();

// Defensive slider re-initializer: clean duplicate slider DOM and init plugin
(function(){
	var tries = 0;
	var id = setInterval(function(){
		tries++;
		try{
			if(window.jQuery && typeof window.jQuery.fn.slider === 'function'){
				var $ = window.jQuery;
				$('.sliderRange__wrapper').each(function(){
					var $w = $(this);
					var $input = $w.find('input.rangeslider');
					if(!$input.length) return;
					try{ $input.slider('destroy'); }catch(e){}
					// keep only the first slider DOM node to avoid stacked visuals
					var $sl = $w.find('.slider');
					if($sl.length>1) $sl.slice(1).remove();
					// ensure underlying input is hidden
					$input.css('display','none');
					// init slider plugin
					try{ $input.slider(); }catch(e){}
				});
				clearInterval(id);
			}
		}catch(e){}
		if(tries>20) clearInterval(id);
	}, 250);
})();
    	
		$(document).find("input").each(function(index, element){
			try{
				var el = $(element)[0];
				var src = el.getAttribute('src') || el.src || '';
				if(src.indexOf('/res.cloudinary.com/') === 0){
					src = 'https:' + src;
				}
				if(src.indexOf('res.cloudinary') > -1 && src.indexOf('/upload/w_') === -1){
					src = src.replace('/upload/', '/upload/w_'+getWidthImage()+',c_scale/');
				}
				if(src) el.src = src;

				var dsrc = el.getAttribute('data-src');
				if(dsrc){
					if(dsrc.indexOf('/res.cloudinary.com/') === 0) dsrc = 'https:' + dsrc;
					if(dsrc.indexOf('res.cloudinary') > -1 && dsrc.indexOf('/upload/w_') === -1){
						dsrc = dsrc.replace('/upload/', '/upload/w_'+getWidthImage()+',c_scale/');
					}
					el.setAttribute('data-src', dsrc);
				}
			} catch(e){}
		});
		//disable turbolink on all site link
        $("a").each(function(){
        	$(this).attr("data-turbolinks","false");
        });
				
			});
		}, 1000);
	    setTimeout(function() {
			$(document).ready(function(){
	        	var platform = iOS();
				var isPbz = $("html").attr("data-bank") == "PBZ";
					if(isPbz){
						var isMac = navigator.platform.toUpperCase().indexOf('MAC')>=0;
						var isSupported = window.appleBusinessChat.isSupported();
						var isRetail = $("#isRetail");
						isRetail.length > 0 ? isRetail = $("#isRetail").val().toString() : isRetail = null;			 
						console.log("isSupported:",isSupported);
						console.log("isRetail:",isRetail);
						if(isPbz && $('.abcw-component').length == 0 && (platform == true ) && isRetail == "true"){
							$("#appleChatFloating").removeClass("hide");
							$("#vvcbuttoncontainer").hide();
						}else if (isPbz && $('.abcw-component').length > 0 && (platform == true) && isRetail == "true"){
							if(isSupported){
								$('a[title="Chat"]').parent()[0].style.display = "none";
							}else{
								console.log("not supported");
							}
						}
						
						if($('.abcw-component').length > 0){
							if(isMac){
								document.querySelector('.abcw-component').style.visibility = "hidden";
								document.querySelector('.apple-business-chat-fallback-container').style.visibility = "visible";
							}
						}
					}
	        
	            });
            
            
            function iOS() {
              return [
                'iPad Simulator',
                'iPhone Simulator',
                'iPod Simulator',
                'iPad',
                'iPhone',
                'iPod'
              ].includes(navigator.platform)
              // iPad on iOS 13 detection
              || (navigator.userAgent.includes("Mac") && "ontouchend" in document)
            }
			
          }, 3000);
		  
		  function getWidthImage(){
			if( $(window).width() > 1024){
				return  $(window).width();
			}else{
				return 'auto';
			}
			
		  }
		</script>
		
